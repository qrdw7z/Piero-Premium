{% stylesheet %}
  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
  }

  .product-grid__card swatches-variant-picker-component overflow-list::part(list) { flex-wrap: wrap; }

  .product-grid__card .group-block > :is(.mobile-column, :not(.layout-panel-flex--row)) {
    @media screen and (max-width: 749px) { flex-direction: column; }
  }

  /* Keep every collection and search card on a shared visual baseline. */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: flex;
    height: 100%;
  }

  .product-grid .product-grid__item { min-width: 0; }

  .product-grid .product-card__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 100%;
    width: 100%;
  }

  .product-grid .card-gallery { --gallery-aspect-ratio: 1 !important; }

  .product-grid [ref='productTitleLink'] .text-block {
    display: -webkit-box;
    min-height: 2.8em;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .product-grid product-price { margin-top: auto; }

  .product-card__placeholder-image svg { height: 100%; }
  .product-card__content slideshow-component { --cursor: pointer; }
  @media screen and (max-width: 749px) { .product-card slideshow-arrows .slideshow-control { display: none; } }
{% endstylesheet %}

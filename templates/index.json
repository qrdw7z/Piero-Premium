    "custom_liquid_h4AURX": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% assign editorial_product = collections['yeni-sezon'].products.first %}\n<section class=\"piero-editorial\" aria-labelledby=\"piero-editorial-title\">\n  <div class=\"piero-editorial__copy\">\n    <p class=\"piero-editorial__eyebrow\">PIERO PREMIUM</p>\n    <h2 id=\"piero-editorial-title\">Tarzını her gün yeniden tanımla.</h2>\n    <p>Günlük rahatlığı güçlü ve modern bir duruşla birleştiren seçili parçalar, her ana eşlik etmek için tasarlandı.</p>\n    <p>Özenli dokular, rahat kalıplar ve zahmetsiz kombinlenen tonlarla gardırobunun imza parçalarını keşfet.</p>\n    <a href=\"/collections/yeni-sezon\" class=\"piero-editorial__link\">Yeni sezonu keşfet <span aria-hidden=\"true\">→</span></a>\n  </div>\n  <div class=\"piero-editorial__visual\">\n    {% if editorial_product.featured_image %}\n      <img src=\"{{ editorial_product.featured_image | image_url: width: 1200 }}\" alt=\"{{ editorial_product.title | escape }}\" loading=\"lazy\" width=\"1200\" height=\"1400\">\n    {% endif %}\n    <div class=\"piero-editorial__signature\"><strong>PIERO</strong><span>DAILY · PREMIUM WEAR</span></div>\n  </div>\n</section>\n\n<section class=\"piero-shipping\" aria-labelledby=\"piero-shipping-title\">\n  <div class=\"piero-shipping__content\">\n    <p class=\"piero-shipping__eyebrow\">SİPARİŞİM NEREDE?</p>\n    <h2 id=\"piero-shipping-title\">Kargonuzu kolayca takip edin</h2>\n    <p>Sipariş numaranız ve e-posta adresinizle kargo hareketlerinize saniyeler içinde ulaşın.</p>\n    <a class=\"piero-shipping__button\" href=\"/apps/kargotakip\">Kargo Takip</a>\n    <small>Türkiye’nin her yerine ücretsiz ve güvenli teslimat.</small>\n  </div>\n</section>\n<style>\n.piero-editorial{display:grid;grid-template-columns:1fr 1fr;margin:48px auto;max-width:1200px;background:#f5f5f3;color:#111}.piero-editorial__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(32px,6vw,84px)}.piero-editorial__eyebrow{font-size:.75rem;letter-spacing:.16em;font-weight:700;margin:0 0 16px}.piero-editorial h2{font-size:clamp(2rem,4vw,4rem);line-height:1.02;letter-spacing:-.04em;margin:0 0 24px}.piero-editorial__copy p:not(.piero-editorial__eyebrow){font-size:1.05rem;line-height:1.65;margin:0 0 16px}.piero-editorial__link{margin-top:16px;color:#111;font-weight:700;text-decoration:none;border-bottom:1px solid #111;width:max-content;padding-bottom:7px}.piero-editorial__link span{font-size:1.3em;margin-left:8px}.piero-editorial__visual{min-height:520px;position:relative;background:#ddd;overflow:hidden}.piero-editorial__visual img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;filter:grayscale(1) contrast(1.04)}.piero-editorial__signature{position:absolute;left:24px;bottom:24px;color:#fff;text-shadow:0 2px 16px rgba(0,0,0,.45);display:flex;flex-direction:column;letter-spacing:.16em}.piero-editorial__signature strong{font-size:clamp(2rem,5vw,4.5rem);line-height:.9;letter-spacing:.02em}.piero-editorial__signature span{font-size:.62rem;margin-top:12px;font-weight:700}.piero-shipping{margin:32px auto;padding:clamp(32px,5vw,64px);max-width:1200px;background:#0f0f0f;color:#fff;text-align:center;border:1px solid #fff}.piero-shipping__content{max-width:620px;margin:auto}.piero-shipping__eyebrow{letter-spacing:.14em;font-size:.75rem;font-weight:700;color:#fff;margin:0 0 12px}.piero-shipping h2{font-size:clamp(1.8rem,4vw,3.25rem);margin:0 0 14px;line-height:1.1}.piero-shipping p{color:#e0e0e0;line-height:1.6}.piero-shipping__button{display:inline-block;margin:18px 0 16px;padding:14px 28px;background:#fff;color:#111;text-decoration:none;font-weight:700;letter-spacing:.04em}.piero-shipping small{display:block;color:#bdbdbd}@media(max-width:749px){.piero-editorial{grid-template-columns:1fr;margin:24px auto}.piero-editorial__visual{min-height:420px;order:-1}.piero-editorial__copy{padding:32px 24px}}\n</style>",

        "custom_liquid": "<section class=\"arvel-natural-banner\" aria-labelledby=\"arvel-natural-banner-title\">\n  <div class=\"arvel-natural-banner__content\">\n    <p class=\"arvel-natural-banner__eyebrow\">PAMUK &amp; BAMBU</p>\n    <h1 id=\"arvel-natural-banner-title\">Türkiye’nin ilk ve tek <em>%100 doğal içerikli</em> kadın pijama markası.</h1>\n    <p class=\"arvel-natural-banner__description\">Pamuk ve bambunun doğal yumuşaklığıyla, günün her anına eşlik eden rahatlık.</p>\n    <a class=\"arvel-natural-banner__cta\" href=\"{{ routes.all_products_collection_url }}\">Pijamaları keşfet <span aria-hidden=\"true\">→</span></a>\n    <ul class=\"arvel-natural-banner__notes\" aria-label=\"Ürün özellikleri\"><li>Pamuk</li><li>Bambu</li><li>Nefes alan doku</li></ul>\n  </div>\n</section>\n<style>\n.arvel-natural-banner{min-height:clamp(520px,62vw,760px);display:flex;align-items:center;padding:clamp(32px,6vw,96px);background-image:linear-gradient(90deg,rgba(248,243,235,.97) 0%,rgba(248,243,235,.91) 34%,rgba(248,243,235,.18) 60%,rgba(248,243,235,0) 100%),url('{{ 'arvel-pink-ribbed-pajama-hero.jpg' | asset_url }}');background-position:center;background-size:cover;color:#2d2a25}.arvel-natural-banner__content{width:min(100%,590px)}.arvel-natural-banner__eyebrow{margin:0 0 16px;font-size:.72rem;font-weight:700;letter-spacing:.18em}.arvel-natural-banner h1{margin:0;font-size:clamp(2.35rem,5vw,5.25rem);font-weight:500;letter-spacing:-.065em;line-height:.96}.arvel-natural-banner h1 em{font-family:Georgia,serif;font-weight:400}.arvel-natural-banner__description{max-width:430px;margin:24px 0 0;font-size:clamp(1rem,1.5vw,1.2rem);line-height:1.55}.arvel-natural-banner__cta{display:inline-flex;gap:18px;align-items:center;margin-top:30px;padding:14px 0;color:inherit;font-weight:700;text-decoration:none;border-bottom:1px solid currentColor}.arvel-natural-banner__cta span{font-size:1.3em}.arvel-natural-banner__notes{display:flex;flex-wrap:wrap;gap:10px 22px;margin:34px 0 0;padding:0
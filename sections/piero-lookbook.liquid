{% comment %}
  Editorial outfit strip. Uses images supplied with the theme and intentional,
  storefront-first typography to keep the home page compact and shoppable.
{% endcomment %}

<section class="piero-lookbook" aria-labelledby="piero-lookbook-{{ section.id }}">
  <div class="piero-lookbook__heading">
    <p class="piero-lookbook__eyebrow">{{ section.settings.eyebrow }}</p>
    <div>
      <h2 id="piero-lookbook-{{ section.id }}">{{ section.settings.heading }}</h2>
      {% if section.settings.link_label != blank %}
        <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="piero-lookbook__link">
          {{ section.settings.link_label }} <span aria-hidden="true">↗</span>
        </a>
      {% endif %}
    </div>
  </div>

  <div class="piero-lookbook__grid">
    {% for block in section.blocks %}
      {% assign image_alt = block.settings.image.alt | default: block.settings.title %}
      <a class="piero-lookbook__card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 33vw, 75vw', class: 'piero-lookbook__image', alt: image_alt }}
        {% else %}
          <img class="piero-lookbook__image" src="{{ block.settings.fallback_image | asset_url }}" loading="lazy" width="900" height="1200" alt="{{ block.settings.title | escape }}">
        {% endif %}
        <span class="piero-lookbook__caption">
          <span>{{ block.settings.title }}</span>
          <span aria-hidden="true">+</span>
        </span>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .piero-lookbook {
    padding: clamp(3.75rem, 7vw, 7rem) max(1.25rem, calc((100vw - 1440px) / 2));
    background: #f4f2ee;
  }

  .piero-lookbook__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    max-width: 1440px;
    margin: 0 auto 2.25rem;
  }

  .piero-lookbook__eyebrow,
  .piero-lookbook__link,
  .piero-lookbook__caption {
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .piero-lookbook__eyebrow { margin: 0 0 .35rem; color: #6e6a63; }
  .piero-lookbook__heading h2 { margin: 0 0 .75rem; font-size: clamp(2rem, 4vw, 4.25rem); line-height: .95; letter-spacing: -.065em; }
  .piero-lookbook__link { color: #111; text-underline-offset: .45rem; }
  .piero-lookbook__link span { margin-inline-start: .3rem; font-size: 1rem; }

  .piero-lookbook__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(.65rem, 1.2vw, 1.25rem);
    max-width: 1440px;
    margin: auto;
  }

  .piero-lookbook__card { position: relative; display: block; overflow: hidden; color: #fff; background: #dfddd7; aspect-ratio: 3 / 4; }
  .piero-lookbook__image { width: 100%; height: 100%; object-fit: cover; transition: transform .55s cubic-bezier(.2, .65, .2, 1); }
  .piero-lookbook__caption { position: absolute; right: 1rem; bottom: 1rem; left: 1rem; display: flex; justify-content: space-between; align-items: center; text-shadow: 0 1px 12px rgb(0 0 0 / .35); }
  .piero-lookbook__caption span:last-child { font-size: 1.2rem; font-weight: 400; }

  @media (hover: hover) { .piero-lookbook__card:hover .piero-lookbook__image { transform: scale(1.04); } }
  @media screen and (max-width: 749px) {
    .piero-lookbook__heading { display: block; margin-bottom: 1.5rem; }
    .piero-lookbook__grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: -1.25rem; padding-inline: 1.25rem; }
    .piero-lookbook__card { flex: 0 0 76vw; scroll-snap-align: start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Piero kombin vitrini",
  "tag": "div",
  "class": "section-piero-lookbook",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst başlık", "default": "Seçili kombinler" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "STİLİNİ TAMAMLA" },
    { "type": "text", "id": "link_label", "label": "Bağlantı metni", "default": "TÜM KOMBİNLER" },
    { "type": "url", "id": "link", "label": "Bağlantı" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Kombin",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Görsel" },
        { "type": "text", "id": "fallback_image", "label": "Yedek tema görseli", "default": "instagram-products/triko-kazak-haki-kombin.jpg" },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Yeni kombin" },
        { "type": "url", "id": "link", "label": "Bağlantı" }
      ]
    }
  ],
  "presets": [{ "name": "Piero kombin vitrini", "blocks": [{ "type": "look", "settings": { "title": "Triko & denim", "fallback_image": "instagram-products/triko-kazak-haki-kombin.jpg" } }, { "type": "look", "settings": { "title": "Günlük kesimler", "fallback_image": "instagram-products/oversize1.jpg" } }, { "type": "look", "settings": { "title": "Yeni sezon", "fallback_image": "instagram-products/baklava-desenli-triko-gabardin-kombin.jpg" } }] }]
}
{% endschema %}

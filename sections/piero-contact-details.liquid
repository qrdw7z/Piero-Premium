<section class="piero-contact" aria-labelledby="piero-contact-title-{{ section.id }}">
  <div class="piero-contact__inner">
    <div class="piero-contact__intro">
      <p class="piero-contact__eyebrow">ARVEL DESTEK</p>
      <h1 id="piero-contact-title-{{ section.id }}">{{ section.settings.heading }}</h1>
      <div class="piero-contact__copy">{{ section.settings.description }}</div>
    </div>

    <div class="piero-contact__details" aria-label="İletişim bilgileri">
      {% if section.settings.merchant_name != blank %}
        <div class="piero-contact__item">
          <span>Satıcı</span><strong>{{ section.settings.merchant_name }}</strong>
        </div>
      {% endif %}
      {% if section.settings.phone != blank %}
        <a class="piero-contact__item" href="tel:{{ section.settings.phone | remove: ' ' }}">
          <span>Telefon & WhatsApp</span><strong>{{ section.settings.phone }}</strong>
        </a>
      {% endif %}
      {% if section.settings.email != blank %}
        <a class="piero-contact__item" href="mailto:{{ section.settings.email }}">
          <span>E-posta</span><strong>{{ section.settings.email }}</strong>
        </a>
      {% endif %}
      {% if section.settings.address != blank %}
        <div class="piero-contact__item">
          <span>Adres</span><strong>{{ section.settings.address | newline_to_br }}</strong>
        </div>
      {% endif %}
      {% if section.settings.instagram_url != blank %}
        <a class="piero-contact__item" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">
          <span>Instagram</span><strong>Instagram ↗</strong>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .piero-contact { padding: clamp(3rem, 8vw, 7rem) max(1.25rem, calc((100vw - 1440px) / 2)); color: #171715; }
  .piero-contact__inner { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .85fr); gap: clamp(2.5rem, 8vw, 9rem); max-width: 1440px; margin: auto; }
  .piero-contact__eyebrow, .piero-contact__item span { margin: 0 0 .8rem; color: #6e6a63; font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .piero-contact h1 { margin: 0; max-width: 9ch; font-size: clamp(3rem, 7vw, 6.5rem); letter-spacing: -.075em; line-height: .86; }
  .piero-contact__copy { max-width: 31rem; margin-top: 1.5rem; color: #56534e; line-height: 1.6; }
  .piero-contact__copy p { margin: 0; }
  .piero-contact__details { border-top: 1px solid rgb(23 23 21 / .25); }
  .piero-contact__item { display: block; padding: 1.25rem 0; color: inherit; text-decoration: none; border-bottom: 1px solid rgb(23 23 21 / .16); }
  .piero-contact__item span, .piero-contact__item strong { display: block; }
  .piero-contact__item span { margin-bottom: .35rem; }
  .piero-contact__item strong { font-size: clamp(1rem, 1.4vw, 1.25rem); line-height: 1.4; }
  a.piero-contact__item:hover strong { text-decoration: underline; text-underline-offset: .25em; }
  @media screen and (max-width: 749px) { .piero-contact__inner { grid-template-columns: 1fr; gap: 3rem; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Arvel iletişim bilgileri",
  "tag": "div",
  "class": "section-piero-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Bize ulaşın." },
    { "type": "richtext", "id": "description", "label": "Açıklama", "default": "<p>Sipariş, beden ve ürün soruların için bize yaz. Ekibimiz en kısa sürede dönüş yapar.</p>" },
    { "type": "text", "id": "merchant_name", "label": "Satıcı unvanı" },
    { "type": "text", "id": "phone", "label": "Telefon", "default": "+90 552 486 98 77" },
    { "type": "email", "id": "email", "label": "E-posta" },
    { "type": "textarea", "id": "address", "label": "Açık adres" },
    { "type": "url", "id": "instagram_url", "label": "Instagram bağlantısı" }
  ]
}
{% endschema %}
